{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "version": "0.4.1",
  "name": "macro-progress",
  "kind": "component",
  "description": "Nutrition progress via ProgressView.",
  "usage": "MacroProgress(\n    \"Protein\",\n    value: Text(\"96 g\"),\n    target: Text(\"130 g\"),\n    progress: 96.0 / 130.0,\n    systemImage: \"fish.fill\"\n)\n.registryTint(.indigo)",
  "files": [
    {
      "source": "sources/components/MacroProgress.swift",
      "target": "MacroProgress.swift"
    }
  ],
  "registryDependencies": [],
  "packageDependencies": [
    {
      "package": "SwiftUIRegistry",
      "product": "SwiftUIRegistryFoundations",
      "requirement": "0.x",
      "sourceURL": "https://github.com/mangobyte-dev/swiftui-ui-registry.git",
      "swiftPM": {
        "kind": "upToNextMinor",
        "minimumVersion": "0.3.0"
      }
    }
  ],
  "platforms": [
    {
      "name": "iOS",
      "minimumVersion": "26.0"
    }
  ],
  "tags": [
    "nutrition",
    "health",
    "progress",
    "macronutrients"
  ],
  "accessibility": [
    "Native semantics.",
    "Width-limited: ViewThatFits moves values below label.",
    "One localized phrase.",
    "No tint-alone meaning."
  ],
  "preview": {
    "source": "sources/components/MacroProgress.swift",
    "name": "Macro Progress",
    "screenshots": [
      "docs/images/items/macro-progress-light.png",
      "docs/images/items/macro-progress-dark.png"
    ]
  }
}
