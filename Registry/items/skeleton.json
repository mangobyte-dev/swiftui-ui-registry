{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "version": "0.2.1",
  "name": "skeleton",
  "kind": "component",
  "description": "Turns any view into loading placeholder with native redaction.",
  "usage": "@State private var isLoading = true\n\nActivityRows()\n    .registrySkeleton(isLoading)\n\n// Pass false to render the real content unchanged.",
  "files": [
    {
      "source": "sources/components/RegistrySkeletonModifier.swift",
      "target": "RegistrySkeletonModifier.swift"
    }
  ],
  "registryDependencies": [],
  "packageDependencies": [
    {
      "package": "SwiftUIRegistry",
      "product": "SwiftUIRegistryFoundations",
      "requirement": "0.x",
      "sourceURL": "https://github.com/mangobyte-dev/swiftui-ui-registry.git",
      "swiftPM": {
        "kind": "upToNextMinor",
        "minimumVersion": "0.3.0"
      }
    }
  ],
  "platforms": [
    {
      "name": "iOS",
      "minimumVersion": "26.0"
    }
  ],
  "tags": [
    "skeleton",
    "loading",
    "placeholder",
    "redacted",
    "shimmer",
    "shadcn"
  ],
  "aliases": [
    "loading",
    "placeholder",
    "shimmer"
  ],
  "accessibility": [
    "Disables content, excludes hit testing. MUST NOT trigger action.",
    "One element, adjustable label. MUST NOT expose redacted text.",
    "Reduce Motion: static dimmed state, no pulse.",
    "Uses .redacted(.placeholder); keeps identity, state, layout."
  ],
  "preview": {
