{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "version": "0.2.1",
  "name": "spinner",
  "kind": "component",
  "description": "Compact circular indeterminate ProgressView style.",
  "usage": "ProgressView(\"Loading results\")\n    .progressViewStyle(.registrySpinner)",
  "files": [
    {
      "source": "sources/components/RegistrySpinnerStyle.swift",
      "target": "RegistrySpinnerStyle.swift"
    }
  ],
  "registryDependencies": [],
  "packageDependencies": [
    {
      "package": "SwiftUIRegistry",
      "product": "SwiftUIRegistryFoundations",
      "requirement": "0.x",
      "sourceURL": "https://github.com/mangobyte-dev/swiftui-ui-registry.git",
      "swiftPM": {
        "kind": "upToNextMinor",
        "minimumVersion": "0.3.0"
      }
    }
  ],
  "platforms": [
    {
      "name": "iOS",
      "minimumVersion": "26.0"
    }
  ],
  "tags": [
    "spinner",
    "progress-view",
    "circular",
    "loading",
    "style"
  ],
  "aliases": [
    "loading",
    "activity-indicator",
    "progress-circular"
  ],
  "accessibility": [
    "Semantics retained.",
    "Needs label if absent.",
    "Label+indicator combined.",
    "Dynamic Type, tint, enabled, direction."
  ],
  "preview": {
    "source": "sources/components/RegistrySpinnerStyle.swift",
    "name": "Spinner",
    "screenshots": [
      "docs/images/items/spinner-light.png",
      "docs/images/items/spinner-dark.png"
    ]
  }
