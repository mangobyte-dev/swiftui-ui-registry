{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "version": "0.3.2",
  "name": "button-group",
  "kind": "component",
  "description": "ControlGroup: buttons side by side, one variant; keeps roles, labels.",
  "usage": "// Content layer only. In toolbars, tab bars, or floating chrome the system supplies Liquid Glass; use .buttonStyle(.glass) or .buttonStyle(.glassProminent) there instead of .registry styles.\n\nControlGroup {\n    Button(\"Undo\", systemImage: \"arrow.uturn.backward\") {}\n    Button(\"Redo\", systemImage: \"arrow.uturn.forward\") {}\n}\n.controlGroupStyle(.registryButtons)",
  "files": [
    {
      "source": "sources/components/RegistryButtonGroupStyle.swift",
      "target": "RegistryButtonGroupStyle.swift"
    }
  ],
  "registryDependencies": [
    "button"
  ],
  "packageDependencies": [
    {
      "package": "SwiftUIRegistry",
      "product": "SwiftUIRegistryFoundations",
      "requirement": "0.x",
      "sourceURL": "https://github.com/mangobyte-dev/swiftui-ui-registry.git",
      "swiftPM": {
        "kind": "upToNextMinor",
        "minimumVersion": "0.3.0"
      }
    }
  ],
  "platforms": [
    {
      "name": "iOS",
      "minimumVersion": "26.0"
    }
  ],
  "tags": [
    "button",
    "control-group",
    "action",
    "style"
  ],
  "aliases": [
    "control-group",
    "segmented-buttons"
  ],
  "accessibility": [
    "Native Button controls; one container.",
    "Keeps button label, role.",
    "Inherits direction, size, state, Dynamic Type.",
    "Icon-only buttons MUST have labels."
  ],
  "preview": {
    "source": "sources/components/RegistryButtonGroupStyle.swift",
    "name": "Button Group",
    "screenshots": [
      "docs/images/items/button-group-light.png",
      "docs/images/items/button-group-dark.png"
    ]
  }
}
