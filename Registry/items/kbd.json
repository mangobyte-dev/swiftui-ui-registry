{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "version": "0.1.2",
  "name": "kbd",
  "kind": "component",
  "description": "Styles a native Text as a keycap for keyboard shortcut hints, hidden from accessibility unless you supply a spoken label.",
  "usage": "Text(verbatim: \"⌘K\")\n    .registryKeycap(accessibilityLabel: Text(\"Command K\"))\n\nText(verbatim: \"esc\")\n    .registryKeycap()",
  "files": [
    {
      "source": "sources/components/RegistryKeycapModifier.swift",
      "target": "RegistryKeycapModifier.swift"
    }
  ],
  "registryDependencies": [],
  "packageDependencies": [
    {
      "package": "SwiftUIRegistry",
      "product": "SwiftUIRegistryFoundations",
      "requirement": "0.x",
      "sourceURL": "https://github.com/mangobyte-dev/swiftui-ui-registry.git",
      "swiftPM": {
        "kind": "upToNextMinor",
        "minimumVersion": "0.3.0"
      }
    }
  ],
  "platforms": [
    {
      "name": "iOS",
      "minimumVersion": "26.0"
    }
  ],
  "tags": [
    "keyboard",
    "shortcut",
    "keycap",
    "hint",
    "shadcn"
  ],
  "aliases": [
    "keycap",
    "shortcut-hint",
    "hotkey"
  ],
  "accessibility": [
    "The keycap hides from accessibility by default because symbols such as the command glyph read poorly. To speak the shortcut, pass accessibilityLabel.",
    "The keycap stays on one line at its intrinsic size and never wraps.",
    "It uses the compact radius, surface, border, and spacing tokens to match badges."
  ],
  "preview": {
    "source": "sources/components/RegistryKeycapModifier.swift",
    "name": "Keycap",
    "screenshots": [
      "docs/images/items/kbd-light.png",
      "docs/images/items/kbd-dark.png"
    ]
  }
}
