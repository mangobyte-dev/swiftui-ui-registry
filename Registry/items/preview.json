{
  "$schema": "../schema.json",
  "schemaVersion": 1,
  "version": "0.1.0",
  "name": "preview",
  "kind": "block",
  "description": "The theme preview wall from shadcn's create page: an adaptive grid of realistic product cards built from registry components and native controls, so a theme can be judged against a screen of real UI.",
  "usage": "PreviewWall()",
  "files": [
    {
      "source": "sources/blocks/Preview/PreviewWall.swift",
      "target": "Preview/PreviewWall.swift"
    },
    {
      "source": "sources/blocks/Preview/ActivateAgentDialog.swift",
      "target": "Preview/ActivateAgentDialog.swift"
    },
    {
      "source": "sources/blocks/Preview/AnalyticsCard.swift",
      "target": "Preview/AnalyticsCard.swift"
    },
    {
      "source": "sources/blocks/Preview/AnomalyAlert.swift",
      "target": "Preview/AnomalyAlert.swift"
    },
    {
      "source": "sources/blocks/Preview/AssignIssue.swift",
      "target": "Preview/AssignIssue.swift"
    },
    {
      "source": "sources/blocks/Preview/BarChartCard.swift",
      "target": "Preview/BarChartCard.swift"
    },
    {
      "source": "sources/blocks/Preview/BarVisualizer.swift",
      "target": "Preview/BarVisualizer.swift"
    },
    {
      "source": "sources/blocks/Preview/BookAppointment.swift",
      "target": "Preview/BookAppointment.swift"
    },
    {
      "source": "sources/blocks/Preview/CodespacesCard.swift",
      "target": "Preview/CodespacesCard.swift"
    },
    {
      "source": "sources/blocks/Preview/ContributionsActivity.swift",
      "target": "Preview/ContributionsActivity.swift"
    },
    {
      "source": "sources/blocks/Preview/Contributors.swift",
      "target": "Preview/Contributors.swift"
    },
    {
      "source": "sources/blocks/Preview/EnvironmentVariables.swift",
      "target": "Preview/EnvironmentVariables.swift"
    },
    {
      "source": "sources/blocks/Preview/FeedbackForm.swift",
      "target": "Preview/FeedbackForm.swift"
    },
    {
      "source": "sources/blocks/Preview/FileUpload.swift",
      "target": "Preview/FileUpload.swift"
    },
    {
      "source": "sources/blocks/Preview/DeveloperProfile.swift",
      "target": "Preview/DeveloperProfile.swift"
    },
    {
      "source": "sources/blocks/Preview/IconPreviewGrid.swift",
      "target": "Preview/IconPreviewGrid.swift"
    }
  ],
  "registryDependencies": [
    "card",
    "item",
    "alert",
    "badge",
    "button",
    "chart",
    "empty",
    "avatar",
    "combobox",
    "separator",
    "field",
    "input-group",
    "spinner",
    "checkbox",
    "textarea",
    "input"
  ],
  "packageDependencies": [
    {
      "package": "SwiftUIRegistry",
      "product": "SwiftUIRegistryFoundations",
      "requirement": "0.x",
      "sourceURL": "https://github.com/mangobyte-dev/swiftui-ui-registry.git",
      "swiftPM": {
        "kind": "upToNextMinor",
        "minimumVersion": "0.1.0"
      }
    }
  ],
  "platforms": [
    {
      "name": "iOS",
      "minimumVersion": "26.0"
    }
  ],
  "tags": [
    "preview",
    "theme",
    "showcase",
    "cards",
    "create",
    "shadcn",
    "dashboard"
  ],
  "aliases": [
    "theme-preview",
    "create",
    "wall",
    "gallery"
  ],
  "accessibility": [
    "Every interactive control carries an accessibility label and every decorative SF Symbol is hidden, so the capture-route audit finds no unlabeled button, image, switch, text field, or slider on any card.",
    "Avatars read the person or account name as their label, never the drawn initials.",
    "Actions that open a dialog use a native alert or sheet, so the decision keeps the system's modal semantics and focus handling.",
    "Each card is a native GroupBox on the shared card surface and composes native controls, so Dynamic Type, color scheme, and layout direction are respected without per-card handling."
  ],
  "preview": {
    "source": "sources/blocks/Preview/PreviewWall.swift",
    "name": "Preview Wall",
    "screenshots": [
      "docs/images/items/preview-light.png",
      "docs/images/items/preview-dark.png"
    ]
  }
}
